# BankSim AI — example environment file.
#
# Copy to `.env` and fill in values as needed. NEVER commit your real `.env`
# (it is gitignored). Nothing here is required to run the simulators, the
# scenarios, the glossary, or the Learning Hub — those are fully client-side.

# ── Web app ───────────────────────────────────────────────────────────
# Where the Python API lives. Defaults to http://localhost:8000 if unset,
# which is correct for local development.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI Finance Tutor (milestone M6 — not yet built) ───────────────────
# Get a key at https://console.anthropic.com/. Keep it secret.
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-haiku-4-5
# TUTOR_MONTHLY_BUDGET_INR=800

# ── Accounts & persistence (milestone M3 — not yet built) ─────────────
# Requires Docker Desktop for PostgreSQL + Redis.
# DATABASE_URL=postgresql://banksim:banksim@localhost:5432/banksim
# REDIS_URL=redis://localhost:6379/0
# AUTH_SECRET=            # generate: openssl rand -base64 32
# API_JWT_SECRET=         # generate: openssl rand -base64 32
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Monitoring (optional, milestone M8) ───────────────────────────────
# SENTRY_DSN=
